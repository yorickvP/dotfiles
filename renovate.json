{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "nix": {
    "enabled": true
  },
  "lockFileMaintenance": {
    "enabled": true
  },
  "pyenv": {
    "enabled": false
  },
  "gomod": {
    "enabled": false
  },
  "pep723": {
    "fileMatch": ["bin/.*\\.py$"]
  },
  "packageRules": [
    {
      "matchManagers": ["pep723"],
      "postUpgradeTasks": {
        "commands": ["uv lock --script {{{packageFile}}}"],
        "fileFilters": ["bin/*.lock"]
      }
    }
  ]
}
